<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="FlexForceBinding">
                    <security mode="Transport"/>
                </binding>
                <binding name="FlexForceBinding1"/>
                <binding name="FlexForceBinding2">
                    <security mode="Transport"/>
                </binding>
                <binding name="FlexForceBinding3"/>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://rc.quinyx.com/FlexForceWebServices.php" binding="basicHttpBinding" bindingConfiguration="FlexForceBinding2" contract="QuinyxRCReference.FlexForcePortType" name="FlexForcePort1"/>
            <endpoint address="https://app.quinyx.com/FlexForceWebServices.php" binding="basicHttpBinding" bindingConfiguration="FlexForceBinding" contract="QuinyxReference.FlexForcePortType" name="FlexForcePort"/>
        </client>
    </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
